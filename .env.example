# ==============================================================================
# GVG (Gestion de Vide-Greniers) - Fichier de Configuration Modèle (.env.example)
# ==============================================================================
# Copiez ce fichier sous le nom '.env' à la racine du projet (pour Docker Compose)
# ou dans 'backend/.env' (pour le déploiement natif Ubuntu).
#
# Commande recommandée pour initialiser :
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PARAMÈTRES GÉNÉRAUX DE L'APPLICATION
# ------------------------------------------------------------------------------
# Nom officiel affiché dans l'interface et les e-mails
PROJECT_NAME="GVG (Gestion de Vide-Greniers)"

# Environnement d'exécution : 'development' ou 'production'
# En production, les rechargements automatiques et logs verbeux sont désactivés.
ENVIRONMENT=production

# Préfixe d'API REST
API_V1_STR=/api/v1

# Clé secrète pour la signature des tokens JWT d'administration (À MODIFIER EN PRODUCTION)
# Vous pouvez en générer une sécurisée avec : openssl rand -hex 32
JWT_SECRET_KEY=changer_cette_cle_secrete_jwt_par_une_chaine_aleatoire_tres_longue

# ------------------------------------------------------------------------------
# 2. BASE DE DONNÉES POSTGRESQL & POSTGIS
# ------------------------------------------------------------------------------
# Identifiants du compte utilisateur PostgreSQL
POSTGRES_USER=gvg

# Mot de passe de la base de données (À MODIFIER IMPÉRATIVEMENT EN PRODUCTION)
# Vous pouvez en générer un fort avec : openssl rand -hex 16
POSTGRES_PASSWORD=changer_ce_mot_de_passe_secret_par_un_fort

# Nom de la base de données
POSTGRES_DB=gvg

# Port d'écoute du serveur PostgreSQL
POSTGRES_PORT=5432

# Chaîne de connexion SQLAlchemy (driver psycopg 3)
# Pour un déploiement natif Ubuntu (localhost) :
DATABASE_URL=postgresql+psycopg://gvg:changer_ce_mot_de_passe_secret_par_un_fort@localhost:5432/gvg
# Pour un déploiement Docker Compose (hôte 'db') :
# DATABASE_URL=postgresql+psycopg://gvg:changer_ce_mot_de_passe_secret_par_un_fort@db:5432/gvg

# ------------------------------------------------------------------------------
# 3. DOMAINE, RÉSEAU & SÉCURITÉ CORS
# ------------------------------------------------------------------------------
# URL racine publique du frontend pour la génération des liens dans les e-mails
# Exemples : http://localhost, http://localhost:5173 ou https://vide-grenier.mon-village.fr
FRONTEND_BASE_URL=http://localhost

# URL de l'API Backend pour les requêtes frontend (ex: http://localhost:8000 en dev, http://localhost en prod derrière Nginx)
VITE_API_URL=http://localhost

# Origines autorisées pour le partage de ressources cross-origin (CORS)
# Séparer les URL par des virgules sans espaces
CORS_ORIGINS=http://localhost,http://localhost:5173,http://127.0.0.1:5173

# Répertoire de stockage local pour les uploads (ex: fonds de plans)
UPLOAD_DIR=uploads

# ------------------------------------------------------------------------------
# 4. PAIEMENTS SÉCURISÉS STRIPE
# ------------------------------------------------------------------------------
# Clé secrète de l'API Stripe (format sk_test_... ou sk_live_...)
STRIPE_SECRET_KEY=sk_test_votre_cle_secrete_stripe

# Clé publique Stripe pour les composants UI Stripe Elements (format pk_test_... ou pk_live_...)
STRIPE_PUBLISHABLE_KEY=pk_test_votre_cle_publique_stripe

# Secret du webhook Stripe pour vérifier l'authenticité des notifications de paiement
# Obtenu dans le Dashboard Stripe -> Développeurs -> Webhooks (format whsec_...)
STRIPE_WEBHOOK_SECRET=whsec_votre_secret_webhook_stripe

# ------------------------------------------------------------------------------
# 5. ENVOI D'EMAILS TRANSACTIONNELS (SMTP)
# ------------------------------------------------------------------------------
# Serveur SMTP sortant (ex: smtp.gmail.com, mail.infomaniak.com, smtp.sendgrid.net)
SMTP_HOST=smtp.example.com

# Port SMTP (généralement 587 pour STARTTLS, ou 465 pour SSL)
SMTP_PORT=587

# Identifiant de connexion SMTP (laisser vide si aucune authentification requise)
SMTP_USER=contact@example.com

# Mot de passe SMTP
SMTP_PASSWORD=secret_smtp_password

# Chiffrement TLS / STARTTLS (True recommandé sur le port 587)
SMTP_TLS=True

# Chiffrement SSL direct (True sur le port 465, False sur le port 587)
SMTP_SSL=False

# Adresse d'expéditeur utilisée pour les confirmations et attestations
EMAILS_FROM_EMAIL=noreply@example.com

# Nom de l'expéditeur apparaissant dans les boîtes de réception
EMAILS_FROM_NAME="GVG - Vide-Greniers"
