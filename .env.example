# GVG Environment Configuration Example

# Project details
PROJECT_NAME="GVG (Gestion de Vide-Greniers)"
ENVIRONMENT="development"

# Database connection string (PostgreSQL + PostGIS)
DATABASE_URL="postgresql+psycopg://gvg:gvg_secret@localhost:5432/gvg"

# CORS Origins (comma-separated or JSON list)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000"

# Secret Token for Magic Link URLs (AD-5)
SECRET_KEY="generate-a-secure-random-token-for-production"

# Stripe Integration (Future stories)
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

